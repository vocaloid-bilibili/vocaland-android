<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

    <TextView
            android:id="@+id/bgm_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"/>

    <TextView
            android:id="@+id/bgm_notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

        <ImageButton
                android:id="@+id/bgm_notification_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="上一首"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/notification_button_tint"/>

        <ImageButton
                android:id="@+id/bgm_notification_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="播放"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/notification_button_tint"/>

        <ImageButton
                android:id="@+id/bgm_notification_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="下一首"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_next"
                android:tint="@color/notification_button_tint"/>
    </LinearLayout>
</LinearLayout>
